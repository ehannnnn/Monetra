<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow hitam -->
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/monetra_black" />
        </shape>
    </item>

    <!-- Background hijau dengan border hitam -->
    <item
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@color/monetra_green" />
            <stroke
                android:width="1.5dp"
                android:color="@color/monetra_black" />
        </shape>
    </item>

</layer-list>