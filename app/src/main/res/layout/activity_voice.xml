<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/monetra_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brutal_button_yellow"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_wallet_monetra"
                        app:tint="@color/monetra_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:text="Monetra"
                        android:textColor="@color/monetra_black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_brutal_button_white"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/monetra_black" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_brutal_button_white"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell_monetra"
                    app:tint="@color/monetra_black" />

            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvListeningStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="🔴 SEDANG MENDENGARKAN"
                    android:textColor="@color/monetra_black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_green"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_microphone"
                        app:tint="@color/monetra_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:text="Live AI"
                        android:textColor="@color/monetra_black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:text="Aku dengerin..."
                android:textColor="@color/monetra_black"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="Bicara santai, sebutkan pengeluaran atau pemasukanmu."
                android:textColor="@color/monetra_gray_text"
                android:textSize="13sp" />

            <!-- Transcription Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_brutal_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_outline"
                        android:backgroundTint="@color/monetra_purple"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="✦ Deteksi Suara Instan"
                        android:textColor="@color/monetra_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRecordingTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="00:00"
                        android:textColor="@color/monetra_gray_text"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:gravity="center_vertical"
                    android:text="Silakan mulai berbicara..."
                    android:textColor="@color/monetra_black"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E0DC" />

                <TextView
                    android:id="@+id/tvRecognitionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="Menunggu suara..."
                    android:textColor="@color/monetra_gray_text"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Audio Visualizer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_brutal_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <app.project.monetra.VoiceVisualizer
                    android:id="@+id/audioVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="65dp" />

                <TextView
                    android:id="@+id/tvAudioLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="Audio Sensitif 0 dB"
                    android:textColor="@color/monetra_gray_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Microphone Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="12dp"
                android:foregroundGravity="center">

                <View
                    android:id="@+id/micOuterCircle"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill_outline"
                    android:backgroundTint="#FFD6D6" />

                <ImageButton
                    android:id="@+id/btnMicrophone"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_mic"
                    android:backgroundTint="@null"
                    android:contentDescription="Mikrofon"
                    android:padding="22dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/monetra_white" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvMicInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_semibold"
                android:gravity="center"
                android:text="Ketuk untuk berhenti"
                android:textColor="@color/monetra_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Use Transcript Button -->
            <TextView
                android:id="@+id/btnUseTranscript"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_brutal_button_yellow"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="GUNAKAN TEKS →"
                android:textColor="@color/monetra_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Cancel Button -->
            <TextView
                android:id="@+id/btnCancelVoice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_brutal_card"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="×  BATAL"
                android:textColor="@color/monetra_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Manual Input Button -->
            <TextView
                android:id="@+id/btnManualInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_brutal_card"
                android:fontFamily="@font/space_grotesk_medium"
                android:gravity="center"
                android:drawable="@drawable/ic_keyboard"
                android:text="Atau ketik saja manual"
                android:textColor="@color/monetra_black"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
