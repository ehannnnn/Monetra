<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF9F1">

    <!-- ================= FIXED TOP ACTION BAR ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_brutal_button_white"
            android:contentDescription="Kembali"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#000000" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="Catat Manual"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <TextView
            android:id="@+id/badgeOfflineTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_outline"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="🔴 Offline"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnProfile"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_outline"
            android:contentDescription="Profile"
            android:src="@drawable/ic_user_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= FIXED BOTTOM ACTION BUTTON ================= -->
    <FrameLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FBF9F1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_brutal_button_yellow"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="SIMPAN TRANSAKSI"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- ================= SCROLLABLE CONTENT (CENTER) ================= -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Banner Offline Sync -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardOfflineInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brutal_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivZapIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_brutal_button_yellow"
                    android:padding="6dp"
                    android:src="@drawable/ic_cat_sparkle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSyncTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:text="TERSIMPAN DI PERANGKAT"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/badgeOfflineSync"
                    app:layout_constraintStart_toEndOf="@id/ivZapIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSyncSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="Data tersinkron otomatis saat online"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/badgeOfflineSync"
                    app:layout_constraintStart_toEndOf="@id/ivZapIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvSyncTitle" />

                <TextView
                    android:id="@+id/badgeOfflineSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🟢 100% Offline"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Segmented Control: Pengeluaran vs Pemasukan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTypeExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_brutal_button_red"
                    android:drawableStart="@android:drawable/arrow_up_float"
                    android:drawableTint="#FFFFFF"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:paddingHorizontal="12dp"
                    android:text="Pengeluaran"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTypeIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_brutal_button_white"
                    android:drawableStart="@android:drawable/arrow_down_float"
                    android:drawableTint="#2E7D32"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:paddingHorizontal="12dp"
                    android:text="Pemasukan"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Input Nominal Transaksi -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/lblNominal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:text="NOMINAL TRANSAKSI"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblNominalMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="Maks. Rp1 Miliar"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_brutal_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_brutal_button_yellow"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Rp"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNominal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="0"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#CCCCCC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_pill_outline"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="IDR"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNominalError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text=" Nominal harus lebih dari 0"
                android:textColor="#D32F2F"
                android:textSize="12sp" />

            <!-- ================= SECTION PILIH KATEGORI ================= -->
            <LinearLayout
                android:id="@+id/sectionKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/lblKategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:text=" PILIH KATEGORI"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblSelectedCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:text="Makanan &amp; Minuman"
                        android:textColor="#8A2BE2"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Grid Kategori -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="2"
                    android:rowCount="4">

                    <!-- 1. Makanan & Minuman -->
                    <LinearLayout
                        android:id="@+id/catFood"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatFoodIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_food" />

                        <TextView
                            android:id="@+id/tvCatFoodText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Makanan &amp; Minum"
                            android:textColor="@color/monetra_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 2. Transportasi -->
                    <LinearLayout
                        android:id="@+id/catTransport"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatTransportIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_park_p" />

                        <TextView
                            android:id="@+id/tvCatTransportText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Transportasi"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3. Belanja -->
                    <LinearLayout
                        android:id="@+id/catShopping"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatShoppingIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_bag" />

                        <TextView
                            android:id="@+id/tvCatShoppingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Belanja"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 4. Tagihan -->
                    <LinearLayout
                        android:id="@+id/catBills"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatBillsIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_bill" />

                        <TextView
                            android:id="@+id/tvCatBillsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Tagihan"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 5. Hiburan -->
                    <LinearLayout
                        android:id="@+id/catEntertainment"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatEntertainmentIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_gamepad" />

                        <TextView
                            android:id="@+id/tvCatEntertainmentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Hiburan"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 6. Pendidikan -->
                    <LinearLayout
                        android:id="@+id/catEducation"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatEducationIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_grad" />

                        <TextView
                            android:id="@+id/tvCatEducationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Pendidikan"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 7. Lainnya -->
                    <LinearLayout
                        android:id="@+id/catOthers"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_brutal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivCatOthersIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_outline"
                            android:padding="5dp"
                            android:src="@drawable/ic_cat_more" />

                        <TextView
                            android:id="@+id/tvCatOthersText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Lainnya"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 8. Kategori Baru -->
                    <LinearLayout
                        android:id="@+id/catAddNew"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_pill_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/space_grotesk_semibold"
                            android:text="Kategori Baru"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>

            <!-- Tanggal Transaksi Card -->
            <TextView
                android:id="@+id/lblTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:text=" TANGGAL TRANSAKSI"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivCalendarIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_brutal_button_yellow"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#000000" />

                <TextView
                    android:id="@+id/tvDateTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:text="Hari ini, 17 Nov 2026"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnChangeDate"
                    app:layout_constraintStart_toEndOf="@id/ivCalendarIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDateSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="Waktu lokal (WIB)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/btnChangeDate"
                    app:layout_constraintStart_toEndOf="@id/ivCalendarIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvDateTitle" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChangeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_outline"
                    android:drawableEnd="@android:drawable/arrow_down_float"
                    android:drawableTint="#000000"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:paddingHorizontal="12dp"
                    android:text="Ubah"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Catatan / Deskripsi -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/lblCatatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:text="✏️ CATATAN / DESKRIPSI"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="0/100"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lblCatatanOpt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/lblCharCount"
                    android:background="@drawable/bg_badge_bawaan"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Opsional"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </RelativeLayout>

            <EditText
                android:id="@+id/etCatatan"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brutal_card"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="top|start"
                android:hint="Contoh: Sarapan bubur ayam, bayar wifi..."
                android:inputType="textMultiLine"
                android:maxLength="100"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <!-- Lampiran Struk Fisik Section Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutAttachmentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- STATE 1: Default -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutAttachmentDefault"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingHorizontal="14dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivReceiptIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cat_bill"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="Lampiran Struk Fisik:"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnTakePhoto"
                        app:layout_constraintStart_toEndOf="@id/ivReceiptIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_brutal_button_white"
                        android:drawableStart="@android:drawable/ic_menu_camera"
                        android:drawableTint="#000000"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:paddingHorizontal="12dp"
                        android:text="Foto"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- STATE 2: Preview -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutAttachmentPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brutal_card"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPreviewWrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardMaxElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/layoutActionButtons"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivReceiptPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:maxHeight="320dp"
                            android:scaleType="fitCenter"
                            android:src="@android:drawable/ic_menu_gallery" />

                    </androidx.cardview.widget.CardView>

                    <!-- Tombol Aksi Kanan -->
                    <LinearLayout
                        android:id="@+id/layoutActionButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageButton
                            android:id="@+id/btnDeletePhoto"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_brutal_button_red"
                            android:contentDescription="Hapus Foto"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#FFFFFF" />

                        <ImageButton
                            android:id="@+id/btnRetakePhoto"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_brutal_button_white"
                            android:contentDescription="Foto Ulang"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#000000" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
