<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brutal_card"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="16dp"
    tools:ignore="HardcodedText,Autofill">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAddTxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tambah Transaksi"
            android:textColor="@color/monetra_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseAddTx"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_outline"
            android:contentDescription="Tutup"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/monetra_black" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NAMA TRANSAKSI *"
        android:textColor="@color/monetra_black"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTxTitle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_outline"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/monetra_black"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="NOMINAL (RP) *"
        android:textColor="@color/monetra_black"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTxAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_outline"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="@color/monetra_black"
        android:textSize="14sp" />

    <!-- Tombol Batal & Simpan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelAddTx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="Batal"
            android:textColor="@color/monetra_black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveAddTx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_brutal_button_yellow"
            android:gravity="center"
            android:text="Simpan"
            android:textColor="@color/monetra_black"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
