<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_brutal_card"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tambah kategori"
                android:textColor="@color/monetra_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_outline"
                android:contentDescription="Tutup"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/monetra_black" />
        </LinearLayout>

        <!-- Nama Kategori -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NAMA KATEGORI *"
            android:textColor="@color/monetra_black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCategoryName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_outline"
            android:hint="Contoh: Skincare"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/monetra_black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✦ Nama ini otomatis dikenali saat kamu mengetik transaksi."
            android:textColor="@color/monetra_gray_text"
            android:textSize="10sp" />

        <!-- Jenis Transaksi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="JENIS TRANSAKSI"
            android:textColor="@color/monetra_black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnModalPengeluaran"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_red"
                android:gravity="center"
                android:text="↓ Pengeluaran"
                android:textColor="@color/monetra_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModalPemasukan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_white"
                android:gravity="center"
                android:text="↑ Pemasukan"
                android:textColor="@color/monetra_black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ikon (Opsional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IKON (OPSIONAL)"
                android:textColor="@color/monetra_black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih ikon visual"
                android:textColor="@color/monetra_gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Horizontal Scroll Icons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/iconOpt1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_sparkle"
                        app:tint="@color/monetra_black" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iconOpt2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_food"
                        app:tint="@color/monetra_black" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iconOpt3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_bag"
                        app:tint="@color/monetra_black" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iconOpt4"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_fuel"
                        app:tint="@color/monetra_black" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iconOpt5"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_bill"
                        app:tint="@color/monetra_black" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iconOpt6"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_box">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon"
                        android:src="@drawable/ic_cat_gamepad"
                        app:tint="@color/monetra_black" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Warna Tab Folder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WARNA TAB FOLDER"
                android:textColor="@color/monetra_black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvColorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_outline"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="● Tab Ungu"
                android:textColor="@color/monetra_black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Color Selection Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/colorOptGreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_outline"
                android:backgroundTint="@color/monetra_green" />

            <View
                android:id="@+id/colorOptRed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_outline"
                android:backgroundTint="@color/monetra_red" />

            <View
                android:id="@+id/colorOptPurple"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_outline"
                android:backgroundTint="@color/monetra_purple" />

            <View
                android:id="@+id/colorOptYellow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_outline"
                android:backgroundTint="@color/monetra_yellow" />
        </LinearLayout>

        <!-- Preview Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/previewIconBox"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_box"
                android:backgroundTint="#F3E8FF">

                <ImageView
                    android:id="@+id/previewIvIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Preview Icon"
                    android:src="@drawable/ic_cat_sparkle"
                    app:tint="@color/monetra_purple" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/previewTvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skincare"
                    android:textColor="@color/monetra_black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewTvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kategori Pengeluaran"
                    android:textColor="@color/monetra_red"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_outline"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Preview"
                android:textColor="@color/monetra_black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Batal & Simpan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelModal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:text="Batal"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSaveModal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_yellow"
                android:gravity="center"
                android:text="Simpan"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
