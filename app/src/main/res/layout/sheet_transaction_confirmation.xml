<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/monetra_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/monetra_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:text="Cek dulu ya"
                    android:textColor="@color/monetra_black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Monetra sudah mengisi form dari teks kamu."
                    android:textColor="@color/monetra_gray_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_outline"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="AI · teks"
                android:textColor="@color/monetra_black"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_yellow"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Periksa kembali data sebelum menyimpan."
            android:textColor="@color/monetra_black"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="TIPE TRANSAKSI"
            android:textColor="@color/monetra_gray_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnExpense"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_red"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="Pengeluaran"
                android:textColor="@color/monetra_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnIncome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_white"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="Pemasukan"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="NOMINAL"
            android:textColor="@color/monetra_gray_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_brutal_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:text="Rp"
                android:textColor="@color/monetra_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/space_grotesk_bold"
                android:hint="0"
                android:inputType="number"
                android:maxLength="15"
                android:padding="0dp"
                android:textColor="@color/monetra_black"
                android:textColorHint="@color/monetra_gray_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="KATEGORI"
            android:textColor="@color/monetra_gray_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_brutal_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:text="Makanan &amp; Minuman"
            android:textColor="@color/monetra_black"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:text="TANGGAL"
            android:textColor="@color/monetra_gray_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_brutal_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:text="Hari ini"
            android:textColor="@color/monetra_black"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk_bold"
                android:text="DESKRIPSI"
                android:textColor="@color/monetra_gray_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/100"
                android:textColor="@color/monetra_gray_text"
                android:textSize="10sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_brutal_card"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="Tambahkan catatan singkat..."
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:paddingHorizontal="14dp"
            android:textColor="@color/monetra_black"
            android:textColorHint="@color/monetra_gray_text"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_brutal_button_white"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="Batal"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="2"
                android:background="@drawable/bg_brutal_button_yellow"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="Simpan Catatan"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
