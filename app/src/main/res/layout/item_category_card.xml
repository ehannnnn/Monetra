<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <!-- Warna Tab Folder di Pojok Kiri Atas -->
    <View
        android:id="@+id/folderTabColor"
        android:layout_width="76dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_pill_outline"
        android:backgroundTint="@color/monetra_purple" />

    <!-- Kartu Utama -->
    <LinearLayout
        android:id="@+id/categoryCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_brutal_card"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Baris Atas: Ikon + Badge Bawaan/Kustom atau Tombol Edit/Hapus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/catIconBox"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_box"
                android:backgroundTint="@color/monetra_white">

                <ImageView
                    android:id="@+id/ivCatIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cat_food"
                    app:tint="@color/monetra_black" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Badge Bawaan -->
            <TextView
                android:id="@+id/tvBadgeBawaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_bawaan"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="🔒 Bawaan"
                android:textColor="@color/monetra_black"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Tombol Edit & Hapus untuk Kategori Kustom -->
            <LinearLayout
                android:id="@+id/customActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnEditCat"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge_bawaan"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/monetra_black" />

                <ImageView
                    android:id="@+id/btnDeleteCat"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_card_expense"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/monetra_red" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nama Kategori + Badge KUSTOM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Makanan &amp; Minuman"
                android:textColor="@color/monetra_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeKustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_kustom"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="KUSTOM"
                android:textColor="@color/monetra_black"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Jumlah Transaksi + Dot Warna -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTxCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="34 transaksi"
                android:textColor="@color/monetra_gray_text"
                android:textSize="11sp" />

            <View
                android:id="@+id/dotAccent"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_indicator" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>